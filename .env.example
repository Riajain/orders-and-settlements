# Neon / Vercel Postgres. Get these via `vercel env pull .env.local` after linking a project + attaching Neon.
# DATABASE_URL is the pooled connection (for the app); DATABASE_URL_UNPOOLED is direct (for migrations).
DATABASE_URL="postgres://user:pass@host-pooler/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgres://user:pass@host/dbname?sslmode=require"

# Auth.js: generate with `openssl rand -base64 32`
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
